{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest: all",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pytest: login",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q", "tests/ui/login/"],
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pytest: login (registered user)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q", "tests/ui/login/test_login.py::TestLogin::test_login_with_registered_user"],
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pytest: current file",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q", "${file}"],
      "group": "test",
      "presentation": { "reveal": "always" }
    }
  ]
}
